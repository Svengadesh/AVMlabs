@{
    ViewData["Title"] = "Reports Dashboard";
}

<h2>Reports Dashboard</h2>
<hr />

<div class="row mb-4">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-primary text-white">Daily Revenue (Last 30 Days)</div>
            <div class="card-body">
                <canvas id="revenueChart" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header bg-danger text-white">Top 5 Outstanding Clients</div>
            <ul class="list-group list-group-flush" id="topClientsList">
                <!-- populates via js -->
            </ul>
        </div>
        
        <div class="card mt-3">
            <div class="card-body bg-light text-center">
                <h5 class="card-title">Total System Outstanding</h5>
                <h3 id="totalOutstanding" class="text-danger">0.00</h3>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body bg-light text-center">
                <h5 class="card-title">Total Gateway Fees Collected</h5>
                <h3 id="totalFees" class="text-success">0.00</h3>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            // Load chart data
            const resChart = await fetch('/api/reports/daily-summary');
            if (resChart.ok) {
                const data = await resChart.json();
                data.reverse(); // oldest to newest for chart

                const labels = data.map(d => new Date(d.date).toLocaleDateString());
                const revenues = data.map(d => d.totalRevenue);

                const ctx = document.getElementById('revenueChart').getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Daily Revenue',
                            data: revenues,
                            borderColor: 'rgb(75, 192, 192)',
                            tension: 0.1,
                            fill: true,
                            backgroundColor: 'rgba(75, 192, 192, 0.2)'
                        }]
                    },
                    options: {
                        responsive: true
                    }
                });
            }

            // Load outstanding
            const resClients = await fetch('/api/reports/outstanding-clients');
            if (resClients.ok) {
                const clients = await resClients.json();
                const list = document.getElementById('topClientsList');
                clients.forEach(c => {
                    const li = document.createElement('li');
                    li.className = 'list-group-item d-flex justify-content-between align-items-center';
                    li.innerHTML = `${c.clientName} <span class="badge bg-danger rounded-pill">${c.outstandingBalance.toFixed(2)}</span>`;
                    list.appendChild(li);
                });
            }

            // Total Gateway Fees
            const resFees = await fetch('/api/reports/gateway-fees');
            if (resFees.ok) {
                const fees = await resFees.json();
                document.getElementById('totalFees').innerText = fees.totalGatewayFees.toFixed(2);
            }
        });
    </script>
}
