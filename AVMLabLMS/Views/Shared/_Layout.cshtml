<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AVMLabLMS</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="d-flex flex-column h-100 overflow-hidden">
    <header class="top-navbar flex-shrink-0">
        <nav class="navbar navbar-expand-md navbar-light bg-white">
            <div class="container-fluid">
                <!-- Hamburger for mobile -->
                <button class="navbar-toggler me-2 border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu" aria-controls="sidebarMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a class="navbar-brand text-primary fw-bold" asp-area="" asp-controller="Clients" asp-action="Index">
                    AVMLabLMS
                </a>
            </div>
        </nav>
    </header>

    <div class="container-fluid flex-grow-1 overflow-hidden px-0">
        <div class="row h-100 g-0">
            <!-- Sidebar -->
            <nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block sidebar offcanvas-md offcanvas-start h-100 overflow-y-auto" tabindex="-1">
                <div class="offcanvas-header d-md-none border-bottom sidebar-border">
                    <h5 class="offcanvas-title fw-bold text-white">AVMLabLMS</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body d-md-flex flex-column p-0 pt-lg-3">
                    <ul class="nav flex-column w-100 px-2 mt-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Clients" asp-action="Index">
                                <i class="bi bi-people-fill me-2"></i> Dashboard / Clients
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="WorkOrders" asp-action="Create">
                                <i class="bi bi-clipboard2-plus-fill me-2"></i> New Work Order
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-bar-chart-fill me-2"></i> Reports
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 h-100 overflow-y-auto overflow-x-hidden">
                <div class="py-3">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
